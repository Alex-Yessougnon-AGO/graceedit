<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème appliqué à la fenêtre Android pendant le démarrage, mode clair. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Splash système (Android 11 et précédents) : fond ivoire + symbole. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Thème appliqué dès que le processus a démarré : il détermine la couleur
         de la fenêtre derrière l'interface Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
